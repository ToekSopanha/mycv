# Copy this file to `.env` and fill in real values before `docker compose up`.
# `.env` is gitignored; never commit real secrets.

# Backend — used to sign admin JWTs. Generate with:
#   openssl rand -hex 48
JWT_SECRET=Me@$041005

# Frontend — Let's Encrypt certificate subject and registration email.
# DOMAIN must resolve (A/AAAA record) to the host running this stack and
# have TCP 80 + 443 reachable from the public internet.
DOMAIN=sopanha.digital
EMAIL=toeksopanhagamingkh@gmain.com
